# Copy to .env and replace every placeholder with local values.
ESG_API_KEY=replace-with-a-long-random-value
OPENAI_API_KEY=replace-with-provider-api-key
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD_HASH=generate-with-python-generate_admin_hash.py

# Set true when serving over HTTPS; leave false for local HTTP development.
COOKIE_SECURE=false
